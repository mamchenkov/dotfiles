# vim: set ft=i3config ts=4 sw=4 sts=4 expandtab :

# Put local changes in ~/.config/i3/90-local.conf
# and they will be picked up automatically
#
# Please see http://i3wm.org/docs/userguide.html for a complete reference!

#
# 0. Variables (Mod, fonts, etc)
#
include 00-variables.conf

#
# 1. Outputs (monitors, workspaces to outputs)
#
include 10-outputs.conf

#
# 2. Appearance (gaps, borders, colors, bar)
#
include 20-appearance.conf

#
# 3. Keybindings
#
include 30-keybindings.conf

#
# 4. Rules (assignments, for_window)
#
include 40-rules.conf

#
# 5. Startup (exec / exec_always)
#
include 50-startup.conf

#
# 6. Includes (local overrides)
#

# This must be the last one in order to override values
include 90-local.conf
